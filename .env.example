# Provider credentials and model IDs are intentionally blank.
# Copy to .env for local use; never commit .env.

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_OUTPUT_TOKENS=8192

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_OUTPUT_TOKENS=8192

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MAX_OUTPUT_TOKENS=8192

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MAX_OUTPUT_TOKENS=8192

# Optional: a local SQLite database. This may contain generated code if draft caching is enabled.
# POLYMIGRATE_KNOWLEDGE_DB=/absolute/path/to/polymigrate-knowledge.sqlite
# POLYMIGRATE_CACHE_DRAFTS=1

# Optional per-target pre-pulled Docker images for isolated validation.
# POLYMIGRATE_DOCKER_IMAGE_PYTHON=python:3.13
# POLYMIGRATE_DOCKER_IMAGE_GO=golang:1.25
